# Copy this visible template to a local file named .env before running Docker
# Compose. The generated .env contains secrets and must never be uploaded.
POSTGRES_DB=fantasy_sim
POSTGRES_USER=fantasy
POSTGRES_PASSWORD=replace-with-a-long-random-password
APP_PORT=8080

# Optional OpenAI-compatible narrative director. API key may be left blank for
# a trusted local provider that does not require bearer authentication.
FANTASY_AI_ENDPOINT=
FANTASY_AI_API_KEY=
FANTASY_AI_MODEL=
